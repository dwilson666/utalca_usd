# ── Frontend (apps/web) — SOLO claves públicas ────────────────────────────
# La anon key es pública por diseño; la seguridad la da RLS + MFA, no el secreto.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=REEMPLAZAR_CON_LA_ANON_KEY_LOCAL

# ── Edge Functions (supabase/functions) — NUNCA en el bundle del cliente ───
# Se inyectan como secretos del proyecto:  supabase secrets set ...
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR
SUPABASE_URL=http://127.0.0.1:54321

# ── SSO institucional (activar cuando esté disponible) ────────────────────
# AZURE_CLIENT_ID=
# AZURE_SECRET=
# AZURE_TENANT_ID=
